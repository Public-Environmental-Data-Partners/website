# Copy to .env.local and fill in values. For shared or production values (tokens, secrets, deployment env), contact dev@publicenvirodata.org

NEXT_PUBLIC_SANITY_PROJECT_ID= # Sanity project id
NEXT_PUBLIC_SANITY_DATASET= # Dataset (e.g. `production`)
NEXT_PUBLIC_SANITY_API_VERSION= # API version date string
# Absolute site origin (no trailing slash). Used for canonicals, Open Graph, sitemap, JSON-LD.
# Defaults to https://pedp-website.vercel.app when unset — swap once the production domain is ready.
NEXT_PUBLIC_SITE_URL=

# PostHog browser analytics configuration
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to true in .env.local (or Vercel Preview) to capture from non-production
# hosts into the same project, tagged app_environment=non_production. Leave
# unset on Vercel Production.
NEXT_PUBLIC_POSTHOG_CAPTURE_NON_PRODUCTION=

SANITY_API_READ_TOKEN= # Server-only: read token (private dataset + draft perspective)
SANITY_API_WRITE_TOKEN= # Server-only: create newsletterSignup docs from POST /api/newsletter-signup
SANITY_PREVIEW_SECRET= # Server-only: long random string for /api/draft?secret=...
